    <bpmn2:callActivity id="_VER_CLOSURE_NOTICE" drools:independent="true" drools:waitForCompletion="true" name="Generate and send Closure Notification" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Generate and send Closure Notification]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("[BPM][ENTRY:ClosureNotice] process=pru-claim-verification | piid=" + kcontext.getProcessInstance().getId() + " | notificationId=" + kcontext.getVariable("notificationId") + " | generate + send closure notification");
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("cid", kcontext.getVariable("cid"));
json.putPOJO("notificationId", kcontext.getVariable("notificationId"));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[String r = (String) kcontext.getVariable("resPayload");
System.out.println("[BPM][EXIT] pru-claim-verification | resLen=" + (r != null ? String.valueOf(r.length()) : "null"));]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
