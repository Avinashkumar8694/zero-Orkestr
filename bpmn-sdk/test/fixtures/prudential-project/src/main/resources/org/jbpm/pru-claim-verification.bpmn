        <bpmn2:dataOutput id="_VER_UPDATE_STATUS_ResultOutputX" drools:dtype="" itemSubjectRef="___VER_UPDATE_STATUS_ResultOutputXItem" name="Result"/>
        <bpmn2:inputSet id="iset__VER_UPDATE_STATUS">
