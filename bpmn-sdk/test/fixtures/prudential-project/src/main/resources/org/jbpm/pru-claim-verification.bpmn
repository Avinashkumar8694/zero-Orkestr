    <bpmn2:property id="urlClaimsVerificationClose" itemSubjectRef="_urlClaimsVerificationCloseItem" name="urlClaimsVerificationClose"/>
    <bpmn2:property id="urlClaimsVerificationClosureNotice" itemSubjectRef="_urlClaimsVerificationClosureNoticeItem" name="urlClaimsVerificationClosureNotice"/>
    <bpmn2:sequenceFlow id="_F_START" sourceRef="_VER_START" targetRef="_VER_BOOTSTRAP">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_BOOT" sourceRef="_VER_BOOTSTRAP" targetRef="_VER_UPDATE_STATUS">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_STATUS" sourceRef="_VER_UPDATE_STATUS" targetRef="_VER_DECISION">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_DECISION" sourceRef="_VER_DECISION" targetRef="_VER_GW">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_PROMOTE" sourceRef="_VER_GW" targetRef="_VER_PROMOTE" name="Promote to Claim">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Promote to Claim]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_F_PROMOTE_c" language="http://www.java.com/java"><![CDATA[return "PROMOTE".equals(verifierDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_P1" sourceRef="_VER_PROMOTE" targetRef="_VER_SENDCONF">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_P2" sourceRef="_VER_SENDCONF" targetRef="_VER_SYSCLAIM">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_P3" sourceRef="_VER_SYSCLAIM" targetRef="_VER_END_PROMOTE">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_CLOSE" sourceRef="_VER_GW" targetRef="_VER_CLOSE" name="Close">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Close]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_F_CLOSE_c" language="http://www.java.com/java"><![CDATA[return "CLOSE".equals(verifierDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_C1" sourceRef="_VER_CLOSE" targetRef="_VER_CLOSURE_NOTICE">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_C2" sourceRef="_VER_CLOSURE_NOTICE" targetRef="_VER_END_CLOSE">
    </bpmn2:sequenceFlow>
    <bpmn2:startEvent id="_VER_START" name="Verification Process">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Verification Process]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>_F_START</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:scriptTask id="_VER_BOOTSTRAP" name="Script_Bootstrap" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Script_Bootstrap]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_F_START</bpmn2:incoming>
      <bpmn2:outgoing>_F_BOOT</bpmn2:outgoing>
      <bpmn2:script><![CDATA[String url = System.getProperty("INTEGRATION_LAYER_URL");
if (url == null || url.isEmpty()) { url = System.getenv("INTEGRATION_LAYER_URL"); }
if (url == null || url.isEmpty()) {
    try { url = (String) kcontext.getKieRuntime().getEnvironment().get("INTEGRATION_LAYER_URL"); } catch (Exception e) {}
}
if (url == null || url.isEmpty()) { url = "http://localhost:3000"; }
kcontext.setVariable("baseUrl", url);
kcontext.setVariable("urlClaimsStatus", url + "/claims/status");
kcontext.setVariable("urlClaimsVerificationPromote", url + "/claims/verification/promote");
kcontext.setVariable("urlClaimsVerificationSendConfirmation", url + "/claims/verification/send-confirmation");
kcontext.setVariable("urlClaimsVerificationClose", url + "/claims/verification/close");
kcontext.setVariable("urlClaimsVerificationClosureNotice", url + "/claims/verification/closure-notice");
if (kcontext.getVariable("maxRetryCount") == null) { kcontext.setVariable("maxRetryCount", Integer.valueOf(3)); }
System.out.println("[BPM][BOOTSTRAP] process=pru-claim-verification | piid=" + kcontext.getProcessInstance().getId() + " | notificationId=" + kcontext.getVariable("notificationId") + " | baseUrl=" + url);]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:callActivity id="_VER_UPDATE_STATUS" drools:independent="true" drools:waitForCompletion="true" name="Update Case Status to For Verification" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Update Case Status to For Verification]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("[BPM][ENTRY:UpdateStatus] process=pru-claim-verification | piid=" + kcontext.getProcessInstance().getId() + " | notificationId=" + kcontext.getVariable("notificationId") + " | -> FOR_VERIFICATION");
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("cid", kcontext.getVariable("cid"));
json.putPOJO("notificationId", kcontext.getVariable("notificationId"));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.put("status", "FOR_VERIFICATION");
kcontext.setVariable("reqPayload", json.toString());]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[String r = (String) kcontext.getVariable("resPayload");
if (r != null && !r.isEmpty()) { try {
  com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(r);
  if (root.has("status")) kcontext.setVariable("notificationStatus", root.get("status").asText());
} catch(Exception e) {} }]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_F_BOOT</bpmn2:incoming>
      <bpmn2:outgoing>_F_STATUS</bpmn2:outgoing>
      <bpmn2:ioSpecification id="io__VER_UPDATE_STATUS">
        <bpmn2:dataInput id="_VER_UPDATE_STATUS_ContentDataInputX" drools:dtype="" itemSubjectRef="___VER_UPDATE_STATUS_ContentDataInputXItem" name="ContentData"/>
