          <bpmn2:dataInputRefs>_VER_UPDATE_STATUS_ContentTypeInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_VER_UPDATE_STATUS_HandleResponseErrorsInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_VER_UPDATE_STATUS_MethodInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_VER_UPDATE_STATUS_UrlInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="oset__VER_UPDATE_STATUS">
          <bpmn2:dataOutputRefs>_VER_UPDATE_STATUS_ResultOutputX</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="dia__VER_UPDATE_STATUS_cd">
        <bpmn2:sourceRef>reqPayload</bpmn2:sourceRef>
        <bpmn2:targetRef>_VER_UPDATE_STATUS_ContentDataInputX</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia__VER_UPDATE_STATUS_ct">
        <bpmn2:targetRef>_VER_UPDATE_STATUS_ContentTypeInputX</bpmn2:targetRef>
        <bpmn2:assignment id="asg__VER_UPDATE_STATUS_ct">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression" id="asg__VER_UPDATE_STATUS_ctf"><![CDATA[application/json]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression" id="asg__VER_UPDATE_STATUS_ctt">_VER_UPDATE_STATUS_ContentTypeInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia__VER_UPDATE_STATUS_he">
        <bpmn2:targetRef>_VER_UPDATE_STATUS_HandleResponseErrorsInputX</bpmn2:targetRef>
        <bpmn2:assignment id="asg__VER_UPDATE_STATUS_he">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression" id="asg__VER_UPDATE_STATUS_hef"><![CDATA[true]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression" id="asg__VER_UPDATE_STATUS_het">_VER_UPDATE_STATUS_HandleResponseErrorsInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia__VER_UPDATE_STATUS_m">
        <bpmn2:targetRef>_VER_UPDATE_STATUS_MethodInputX</bpmn2:targetRef>
        <bpmn2:assignment id="asg__VER_UPDATE_STATUS_m">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression" id="asg__VER_UPDATE_STATUS_mf"><![CDATA[POST]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression" id="asg__VER_UPDATE_STATUS_mt">_VER_UPDATE_STATUS_MethodInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
