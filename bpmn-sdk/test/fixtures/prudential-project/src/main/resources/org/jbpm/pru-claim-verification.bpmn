    <bpmn2:callActivity id="_VER_PROMOTE" drools:independent="true" drools:waitForCompletion="true" name="Set Notification Status to Verified_Promoted, Generate Case ID" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Set Notification Status to Verified_Promoted, Generate Case ID]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("[BPM][ENTRY:Promote] process=pru-claim-verification | piid=" + kcontext.getProcessInstance().getId() + " | notificationId=" + kcontext.getVariable("notificationId") + " | Verified_Promoted + generate IDs");
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("cid", kcontext.getVariable("cid"));
json.putPOJO("notificationId", kcontext.getVariable("notificationId"));
json.putPOJO("claimType", kcontext.getVariable("claimType"));
json.putPOJO("policyNumber", kcontext.getVariable("policyNumber"));
json.putPOJO("applicablePolicies", kcontext.getVariable("applicablePolicies"));
json.putPOJO("verifierRemarks", kcontext.getVariable("verifierRemarks"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[String r = (String) kcontext.getVariable("resPayload");
if (r != null && !r.isEmpty()) { try {
  com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(r);
  if (root.has("notificationStatus")) kcontext.setVariable("notificationStatus", root.get("notificationStatus").asText());
  if (root.has("caseId")) kcontext.setVariable("caseId", root.get("caseId").asText());
  if (root.has("cid") && !root.get("cid").isNull()) kcontext.setVariable("cid", Integer.valueOf(root.get("cid").asInt()));
  System.out.println("[BPM][EXIT:Promote] pru-claim-verification | caseId=" + kcontext.getVariable("caseId") + " | cid=" + kcontext.getVariable("cid") + " | notificationStatus=" + kcontext.getVariable("notificationStatus") + " (claim ids are generated per-case downstream in Get Claim IDs)");
} catch(Exception e) { System.out.println("[BPM][EXIT:Promote][ERROR] " + e.getMessage()); } }]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
