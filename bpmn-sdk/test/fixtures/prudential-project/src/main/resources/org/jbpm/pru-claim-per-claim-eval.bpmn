      <bpmndi:BPMNShape id="s__B_BOOT" bpmnElement="_B_BOOT"><dc:Bounds height="80.0" width="120.0" x="200.0" y="108.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s__B_EVAL" bpmnElement="_B_EVAL"><dc:Bounds height="80.0" width="140.0" x="360.0" y="108.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s__B_END" bpmnElement="_B_END"><dc:Bounds height="56.0" width="56.0" x="540.0" y="120.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e__B_F1" bpmnElement="_B_F1"><di:waypoint xsi:type="dc:Point" x="156.0" y="148.0"/><di:waypoint xsi:type="dc:Point" x="200.0" y="148.0"/></bpmndi:BPMNEdge>
