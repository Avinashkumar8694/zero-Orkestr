  <bpmn2:itemDefinition id="___B_EVAL_ResultOutputXItem" structureRef=""/>
  <bpmn2:error id="org.jbpm.bpmn2.handler.WorkItemHandlerRuntimeException" errorCode="org.jbpm.bpmn2.handler.WorkItemHandlerRuntimeException"/>
  <bpmn2:error id="TERMINATE_CASE" errorCode="TERMINATE_CASE"/>
  <bpmn2:process id="prudential-claims-submission.pru-claim-per-claim-eval" drools:packageName="org.jbpm" drools:version="1.0" drools:adHoc="false" name="pru-claim-per-claim-eval" isExecutable="true" processType="Public">
    <bpmn2:property id="claimId" itemSubjectRef="_claimIdItem" name="claimId"/>
    <bpmn2:property id="caseId" itemSubjectRef="_caseIdItem" name="caseId"/>
    <bpmn2:property id="claimType" itemSubjectRef="_claimTypeItem" name="claimType"/>
    <bpmn2:property id="cid" itemSubjectRef="_cidItem" name="cid"/>
    <bpmn2:property id="claimStpEligible" itemSubjectRef="_claimStpEligibleItem" name="claimStpEligible"/>
    <bpmn2:property id="claimResult" itemSubjectRef="_claimResultItem" name="claimResult"/>
    <bpmn2:property id="baseUrl" itemSubjectRef="_baseUrlItem" name="baseUrl"/>
    <bpmn2:property id="reqPayload" itemSubjectRef="_reqPayloadItem" name="reqPayload"/>
    <bpmn2:property id="resPayload" itemSubjectRef="_resPayloadItem" name="resPayload"/>
    <bpmn2:property id="maxRetryCount" itemSubjectRef="_maxRetryCountItem" name="maxRetryCount"/>
    <bpmn2:property id="urlEvaluateClaim" itemSubjectRef="_urlEvaluateClaimItem" name="urlEvaluateClaim"/>
    <bpmn2:sequenceFlow id="_B_F1" sourceRef="_B_START" targetRef="_B_BOOT"/>
    <bpmn2:sequenceFlow id="_B_F2" sourceRef="_B_BOOT" targetRef="_B_EVAL"/>
    <bpmn2:sequenceFlow id="_B_F3" sourceRef="_B_EVAL" targetRef="_B_END"/>
    <bpmn2:startEvent id="_B_START" name="Start">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Start]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>_B_F1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:scriptTask id="_B_BOOT" name="Script_Bootstrap" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Script_Bootstrap]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_B_F1</bpmn2:incoming>
      <bpmn2:outgoing>_B_F2</bpmn2:outgoing>
      <bpmn2:script><![CDATA[String url = System.getProperty("INTEGRATION_LAYER_URL");
if (url == null || url.isEmpty()) { url = System.getenv("INTEGRATION_LAYER_URL"); }
if (url == null || url.isEmpty()) { try { url = (String) kcontext.getKieRuntime().getEnvironment().get("INTEGRATION_LAYER_URL"); } catch (Exception e) {} }
if (url == null || url.isEmpty()) { url = "http://localhost:3000"; }
kcontext.setVariable("baseUrl", url);
kcontext.setVariable("urlEvaluateClaim", url + "/claims/evaluate-claim");
if (kcontext.getVariable("maxRetryCount") == null) { kcontext.setVariable("maxRetryCount", Integer.valueOf(3)); }
System.out.println("[BPM][BOOTSTRAP] process=pru-claim-per-claim-eval | piid=" + kcontext.getProcessInstance().getId() + " | caseId=" + kcontext.getVariable("caseId") + " | baseUrl=" + url);]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:callActivity id="_B_EVAL" drools:independent="true" drools:waitForCompletion="true" name="Evaluate Claim (REST)" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname"><drools:metaValue><![CDATA[Evaluate Claim (REST)]]></drools:metaValue></drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY:EvaluateClaim] process=pru-claim-per-claim-eval | piid=" + kcontext.getProcessInstance().getId() + " | cid=" + kcontext.getVariable("cid") + " | caseId=" + kcontext.getVariable("caseId") + " | claimId=" + kcontext.getVariable("claimId"));
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("cid", kcontext.getVariable("cid"));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("claimId", kcontext.getVariable("claimId"));
json.putPOJO("claimType", kcontext.getVariable("claimType"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[String r = (String) kcontext.getVariable("resPayload");
if (r != null && !r.isEmpty()) { try {
  com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(r);
  kcontext.setVariable("claimResult", root);
  if (root.has("claimStpEligible")) kcontext.setVariable("claimStpEligible", Boolean.valueOf(root.get("claimStpEligible").asBoolean()));
  System.out.println("[BPM][EXIT:EvaluateClaim] claimId=" + kcontext.getVariable("claimId") + " | claimStpEligible=" + kcontext.getVariable("claimStpEligible"));
} catch(Exception e) { System.out.println("[BPM][EXIT:EvaluateClaim][ERROR] " + e.getMessage()); } }]]></drools:script></drools:onExit-script>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_B_F2</bpmn2:incoming>
      <bpmn2:outgoing>_B_F3</bpmn2:outgoing>
      <bpmn2:ioSpecification id="io__B_EVAL">
        <bpmn2:dataInput id="_B_EVAL_ContentDataInputX" drools:dtype="" itemSubjectRef="___B_EVAL_ContentDataInputXItem" name="ContentData"/>
        <bpmn2:dataInput id="_B_EVAL_ContentTypeInputX" drools:dtype="" itemSubjectRef="___B_EVAL_ContentTypeInputXItem" name="ContentType"/>
        <bpmn2:dataInput id="_B_EVAL_HandleResponseErrorsInputX" drools:dtype="" itemSubjectRef="___B_EVAL_HandleResponseErrorsInputXItem" name="HandleResponseErrors"/>
        <bpmn2:dataInput id="_B_EVAL_MethodInputX" drools:dtype="" itemSubjectRef="___B_EVAL_MethodInputXItem" name="Method"/>
        <bpmn2:dataInput id="_B_EVAL_UrlInputX" drools:dtype="" itemSubjectRef="___B_EVAL_UrlInputXItem" name="Url"/>
        <bpmn2:dataOutput id="_B_EVAL_ResultOutputX" drools:dtype="" itemSubjectRef="___B_EVAL_ResultOutputXItem" name="Result"/>
        <bpmn2:inputSet id="iset__B_EVAL">
          <bpmn2:dataInputRefs>_B_EVAL_ContentDataInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_B_EVAL_ContentTypeInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_B_EVAL_HandleResponseErrorsInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_B_EVAL_MethodInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_B_EVAL_UrlInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="oset__B_EVAL"><bpmn2:dataOutputRefs>_B_EVAL_ResultOutputX</bpmn2:dataOutputRefs></bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="dia__B_EVAL_cd"><bpmn2:sourceRef>reqPayload</bpmn2:sourceRef><bpmn2:targetRef>_B_EVAL_ContentDataInputX</bpmn2:targetRef></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia__B_EVAL_ct"><bpmn2:targetRef>_B_EVAL_ContentTypeInputX</bpmn2:targetRef><bpmn2:assignment id="asg__B_EVAL_ct"><bpmn2:from xsi:type="bpmn2:tFormalExpression" id="asg__B_EVAL_ctf"><![CDATA[application/json]]></bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression" id="asg__B_EVAL_ctt">_B_EVAL_ContentTypeInputX</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia__B_EVAL_he"><bpmn2:targetRef>_B_EVAL_HandleResponseErrorsInputX</bpmn2:targetRef><bpmn2:assignment id="asg__B_EVAL_he"><bpmn2:from xsi:type="bpmn2:tFormalExpression" id="asg__B_EVAL_hef"><![CDATA[true]]></bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression" id="asg__B_EVAL_het">_B_EVAL_HandleResponseErrorsInputX</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia__B_EVAL_m"><bpmn2:targetRef>_B_EVAL_MethodInputX</bpmn2:targetRef><bpmn2:assignment id="asg__B_EVAL_m"><bpmn2:from xsi:type="bpmn2:tFormalExpression" id="asg__B_EVAL_mf"><![CDATA[POST]]></bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression" id="asg__B_EVAL_mt">_B_EVAL_MethodInputX</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia__B_EVAL_u"><bpmn2:sourceRef>urlEvaluateClaim</bpmn2:sourceRef><bpmn2:targetRef>_B_EVAL_UrlInputX</bpmn2:targetRef></bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="doa__B_EVAL_r"><bpmn2:sourceRef>_B_EVAL_ResultOutputX</bpmn2:sourceRef><bpmn2:targetRef>resPayload</bpmn2:targetRef></bpmn2:dataOutputAssociation>
    </bpmn2:callActivity>
    <bpmn2:endEvent id="_B_END" name="End">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[End]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_B_F3</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>
