  <bpmn2:itemDefinition id="_claimStpEligibleItem" structureRef="Boolean"/>
  <bpmn2:itemDefinition id="_claimResultItem" structureRef="java.lang.Object"/>
  <bpmn2:itemDefinition id="_baseUrlItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_reqPayloadItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_resPayloadItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_maxRetryCountItem" structureRef="Integer"/>
  <bpmn2:itemDefinition id="_urlEvaluateClaimItem" structureRef="String"/>
