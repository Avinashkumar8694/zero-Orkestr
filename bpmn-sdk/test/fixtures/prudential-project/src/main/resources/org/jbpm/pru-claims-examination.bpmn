  <bpmn2:signal id="_SIG_AI_DONE" name="AIClassificationComplete"/>
  <bpmn2:process id="prudential-claims-submission.pru-claims-examination" drools:packageName="org.jbpm" drools:version="1.0" drools:adHoc="false" name="pru-claims-examination" isExecutable="true" processType="Public">
    <bpmn2:property id="caseId" itemSubjectRef="_caseIdItem" name="caseId"/>
    <bpmn2:property id="cid" itemSubjectRef="_cidItem" name="cid"/>
    <bpmn2:property id="claimType" itemSubjectRef="_claimTypeItem" name="claimType"/>
    <bpmn2:property id="policyNumber" itemSubjectRef="_policyNumberItem" name="policyNumber"/>
    <bpmn2:property id="applicablePolicies" itemSubjectRef="_applicablePoliciesItem" name="applicablePolicies"/>
    <bpmn2:property id="dateOfDeath" itemSubjectRef="_dateOfDeathItem" name="dateOfDeath"/>
    <bpmn2:property id="uploadedDocuments" itemSubjectRef="_uploadedDocumentsItem" name="uploadedDocuments"/>
    <bpmn2:property id="policyData" itemSubjectRef="_policyDataItem" name="policyData"/>
    <bpmn2:property id="bankAccountDetails" itemSubjectRef="_bankAccountDetailsItem" name="bankAccountDetails"/>
    <bpmn2:property id="flagContestable" itemSubjectRef="_flagContestableItem" name="flagContestable"/>
    <bpmn2:property id="flagMrxDiscrepancy" itemSubjectRef="_flagMrxDiscrepancyItem" name="flagMrxDiscrepancy"/>
    <bpmn2:property id="claimResults" itemSubjectRef="_claimResultsItem" name="claimResults"/>
    <bpmn2:property id="caseStpEligible" itemSubjectRef="_caseStpEligibleItem" name="caseStpEligible"/>
    <bpmn2:property id="outcome" itemSubjectRef="_outcomeItem" name="outcome"/>
    <bpmn2:property id="payoutAmount" itemSubjectRef="_payoutAmountItem" name="payoutAmount"/>
    <bpmn2:property id="pasLockStatus" itemSubjectRef="_pasLockStatusItem" name="pasLockStatus"/>
    <bpmn2:property id="baseUrl" itemSubjectRef="_baseUrlItem" name="baseUrl"/>
    <bpmn2:property id="reqPayload" itemSubjectRef="_reqPayloadItem" name="reqPayload"/>
    <bpmn2:property id="resPayload" itemSubjectRef="_resPayloadItem" name="resPayload"/>
    <bpmn2:property id="maxRetryCount" itemSubjectRef="_maxRetryCountItem" name="maxRetryCount"/>
    <bpmn2:property id="urlPolicyStatus" itemSubjectRef="_urlPolicyStatusItem" name="urlPolicyStatus"/>
    <bpmn2:property id="urlClaimsCheckContestability" itemSubjectRef="_urlClaimsCheckContestabilityItem" name="urlClaimsCheckContestability"/>
    <bpmn2:property id="urlClaimsMrxCheck" itemSubjectRef="_urlClaimsMrxCheckItem" name="urlClaimsMrxCheck"/>
    <bpmn2:property id="urlClaimsCalculate" itemSubjectRef="_urlClaimsCalculateItem" name="urlClaimsCalculate"/>
    <bpmn2:property id="urlClaimsNigoSend" itemSubjectRef="_urlClaimsNigoSendItem" name="urlClaimsNigoSend"/>
    <bpmn2:property id="urlClaimsStatus" itemSubjectRef="_urlClaimsStatusItem" name="urlClaimsStatus"/>
    <bpmn2:property id="urlClaimsNigoRerunIdp" itemSubjectRef="_urlClaimsNigoRerunIdpItem" name="urlClaimsNigoRerunIdp"/>
    <bpmn2:property id="urlClaimsNigoUpdateStatus" itemSubjectRef="_urlClaimsNigoUpdateStatusItem" name="urlClaimsNigoUpdateStatus"/>
    <bpmn2:sequenceFlow id="_F1" sourceRef="_P_START" targetRef="_P_BOOT">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F2" sourceRef="_P_BOOT" targetRef="_P_CLAIMTYPE">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_DEATH" sourceRef="_P_CLAIMTYPE" targetRef="_P_SETPEND" name="Death">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Death]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_F_DEATH_c" language="http://www.java.com/java"><![CDATA[return "DEATH".equals(claimType);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_TI" sourceRef="_P_CLAIMTYPE" targetRef="_P_TI_RUNEVAL" name="TI">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[TI]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_F_TI_c" language="http://www.java.com/java"><![CDATA[return !"DEATH".equals(claimType);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_TI1" sourceRef="_P_TI_RUNEVAL" targetRef="_P_TI_CONSOLIDATE">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_TI2" sourceRef="_P_TI_CONSOLIDATE" targetRef="_P_TI_ASSIGN">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_TI3" sourceRef="_P_TI_ASSIGN" targetRef="_P_END_REVIEWER">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_SETPEND" sourceRef="_P_SETPEND" targetRef="_P_CHECKCONTEST">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_CHECK" sourceRef="_P_CHECKCONTEST" targetRef="_P_CONTEST_GW">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_CONTEST_YES" sourceRef="_P_CONTEST_GW" targetRef="_P_MRX_PULL" name="Contestable">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Contestable]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_F_CONTEST_YES_c" language="http://www.java.com/java"><![CDATA[return Boolean.TRUE.equals(flagContestable);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_CONTEST_NO" sourceRef="_P_CONTEST_GW" targetRef="_P_CONTEST_MERGE" name="Not contestable">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Not contestable]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_F_CONTEST_NO_c" language="http://www.java.com/java"><![CDATA[return !Boolean.TRUE.equals(flagContestable);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_MRXPULL" sourceRef="_P_MRX_PULL" targetRef="_P_MRX_CHECK">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_MRXCHECK" sourceRef="_P_MRX_CHECK" targetRef="_P_CONTEST_MERGE">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_TORUN" sourceRef="_P_CONTEST_MERGE" targetRef="_P_RUNEVAL">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_RUNEVAL" sourceRef="_P_RUNEVAL" targetRef="_P_AGGREGATE">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_AGG" sourceRef="_P_AGGREGATE" targetRef="_P_OUTCOME">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_STP" sourceRef="_P_OUTCOME" targetRef="_P_CALCBENEFIT" name="STP">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[STP]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_F_STP_c" language="http://www.java.com/java"><![CDATA[return "STP".equals(outcome);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_CALC" sourceRef="_P_CALCBENEFIT" targetRef="_P_END_PAYMENT">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_PENDING" sourceRef="_P_OUTCOME" targetRef="_P_SENDEMAIL" name="Pending Requirement">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Pending Requirement]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_F_PENDING_c" language="http://www.java.com/java"><![CDATA[return "PENDING".equals(outcome);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_SEND" sourceRef="_P_SENDEMAIL" targetRef="_P_UPDATE_PENDING">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_TOPEND" sourceRef="_P_UPDATE_PENDING" targetRef="_P_WAIT">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_DOCS" sourceRef="_P_WAIT" targetRef="_P_AI_SPLIT" name="Documents uploaded">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Documents uploaded]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_AI_REST" sourceRef="_P_AI_SPLIT" targetRef="_P_AI_CLASSIFY">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_AI_SIG" sourceRef="_P_AI_SPLIT" targetRef="_P_AI_SIGNAL">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_AI_REST_J" sourceRef="_P_AI_CLASSIFY" targetRef="_P_AI_JOIN">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_AI_SIG_J" sourceRef="_P_AI_SIGNAL" targetRef="_P_AI_JOIN">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_AI" sourceRef="_P_AI_JOIN" targetRef="_P_UPDATE_CASEDATA">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_LOOP" sourceRef="_P_UPDATE_CASEDATA" targetRef="_P_CONTEST_MERGE">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_TIMEOUT" sourceRef="_P_TIMER" targetRef="_P_ASSIGN_TIMEOUT">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_AT" sourceRef="_P_ASSIGN_TIMEOUT" targetRef="_P_END_EXAMINER_T">
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_EXAMINER" sourceRef="_P_OUTCOME" targetRef="_P_REFER_ASSIGN" name="Refer to Examiner">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Refer to Examiner]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_F_EXAMINER_c" language="http://www.java.com/java"><![CDATA[return "EXAMINER".equals(outcome);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F_RA" sourceRef="_P_REFER_ASSIGN" targetRef="_P_END_EXAMINER_R">
    </bpmn2:sequenceFlow>
    <bpmn2:startEvent id="_P_START" name="Start">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Start]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>_F1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:scriptTask id="_P_BOOT" name="Script_Bootstrap" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Script_Bootstrap]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_F1</bpmn2:incoming>
      <bpmn2:outgoing>_F2</bpmn2:outgoing>
      <bpmn2:script><![CDATA[String url = System.getProperty("INTEGRATION_LAYER_URL");
if (url == null || url.isEmpty()) { url = System.getenv("INTEGRATION_LAYER_URL"); }
if (url == null || url.isEmpty()) { try { url = (String) kcontext.getKieRuntime().getEnvironment().get("INTEGRATION_LAYER_URL"); } catch (Exception e) {} }
if (url == null || url.isEmpty()) { url = "http://localhost:3000"; }
kcontext.setVariable("baseUrl", url);
kcontext.setVariable("urlPolicyStatus", url + "/policy/status");
kcontext.setVariable("urlClaimsCheckContestability", url + "/claims/check-contestability");
kcontext.setVariable("urlClaimsMrxCheck", url + "/claims/mrx-check");
kcontext.setVariable("urlClaimsCalculate", url + "/claims/calculate");
kcontext.setVariable("urlClaimsNigoSend", url + "/claims/nigo/send");
kcontext.setVariable("urlClaimsStatus", url + "/claims/status");
kcontext.setVariable("urlClaimsNigoRerunIdp", url + "/claims/nigo/rerun-idp");
kcontext.setVariable("urlClaimsNigoUpdateStatus", url + "/claims/nigo/update-status");
if (kcontext.getVariable("maxRetryCount") == null) { kcontext.setVariable("maxRetryCount", Integer.valueOf(3)); }
System.out.println("[BPM][BOOTSTRAP] process=pru-claims-examination | caseId=" + kcontext.getVariable("caseId") + " | claimType=" + kcontext.getVariable("claimType") + " | baseUrl=" + url);]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:exclusiveGateway id="_P_CLAIMTYPE" name="Claim Type" gatewayDirection="Diverging">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Claim Type]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_F2</bpmn2:incoming>
      <bpmn2:outgoing>_F_DEATH</bpmn2:outgoing>
      <bpmn2:outgoing>_F_TI</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:callActivity id="_P_SETPEND" drools:independent="true" drools:waitForCompletion="true" name="Set Pol Status to Pend Death to all associated claims" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname"><drools:metaValue><![CDATA[Set Pol Status to Pend Death to all associated claims]]></drools:metaValue></drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY:SetPendDeath] process=pru-claims-examination | caseId=" + kcontext.getVariable("caseId"));
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("cid", kcontext.getVariable("cid"));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("applicablePolicies", kcontext.getVariable("applicablePolicies"));
json.put("status", "PENDING_DEATH_CLAIM");
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script>
