    <bpmn2:callActivity id="_P_CHECKCONTEST" drools:independent="true" drools:waitForCompletion="true" name="Check contestability. ANY policy = contestable" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname"><drools:metaValue><![CDATA[Check contestability. ANY policy = contestable]]></drools:metaValue></drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY:CheckContestability] process=pru-claims-examination | caseId=" + kcontext.getVariable("caseId"));
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("cid", kcontext.getVariable("cid"));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("applicablePolicies", kcontext.getVariable("applicablePolicies"));
json.putPOJO("dateOfDeath", kcontext.getVariable("dateOfDeath"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[String r = (String) kcontext.getVariable("resPayload");
if (r != null && !r.isEmpty()) { try {
  com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(r);
  if (root.has("contestable")) kcontext.setVariable("flagContestable", Boolean.valueOf(root.get("contestable").asBoolean()));
  System.out.println("[BPM][EXIT:CheckContestability] flagContestable=" + kcontext.getVariable("flagContestable"));
} catch(Exception e) { System.out.println("[BPM][EXIT:CheckContestability][ERROR] " + e.getMessage()); } }]]></drools:script></drools:onExit-script>
