    <bpmn2:callActivity id="_P_MRX_CHECK" drools:independent="true" drools:waitForCompletion="true" name="MRX check, Set MRX_Discrepancy Flag" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname"><drools:metaValue><![CDATA[MRX check, Set MRX_Discrepancy Flag]]></drools:metaValue></drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY:MRXCheck] process=pru-claims-examination | caseId=" + kcontext.getVariable("caseId"));
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("cid", kcontext.getVariable("cid"));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[String r = (String) kcontext.getVariable("resPayload");
if (r != null && !r.isEmpty()) { try {
  com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(r);
  boolean disc = root.has("alerts") && root.get("alerts").isArray() && root.get("alerts").size() > 0;
  kcontext.setVariable("flagMrxDiscrepancy", Boolean.valueOf(disc));
  System.out.println("[BPM][EXIT:MRXCheck] flagMrxDiscrepancy=" + disc);
} catch(Exception e) { System.out.println("[BPM][EXIT:MRXCheck][ERROR] " + e.getMessage()); } }]]></drools:script></drools:onExit-script>
      </bpmn2:extensionElements>
