    <bpmn2:scriptTask id="_P_AGGREGATE" name="Aggregate Case_STP_Eligible = All Claim_STP_Eligible" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Aggregate Case_STP_Eligible = All Claim_STP_Eligible]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_F_RUNEVAL</bpmn2:incoming>
      <bpmn2:outgoing>_F_AGG</bpmn2:outgoing>
      <bpmn2:script><![CDATA[// US 10.31 Aggregate: CASE_STP_ELIGIBLE = ALL claims STP-eligible (AD-18: any non-STP
// CLAIM -> whole case non-STP). Outcome (US 10.32): STP if case STP; else EXAMINER if
// any claim needs an examiner (any non-pending exception, or non-contactable pending);
// else PENDING (the only blocking condition across the case is contactable Requirements_Pending).
java.util.List results = (java.util.List) kcontext.getVariable("claimResults");
boolean allStp = true; boolean anyPending = false; boolean anyExaminer = false; int total = 0;
if (results != null) {
  for (Object o : results) {
    total++;
    boolean stp = false, pending = false, examiner = false;
    try {
      if (o instanceof com.fasterxml.jackson.databind.JsonNode) {
        com.fasterxml.jackson.databind.JsonNode n = (com.fasterxml.jackson.databind.JsonNode) o;
        stp = n.has("claimStpEligible") && n.get("claimStpEligible").asBoolean();
        pending = n.has("pendingRequirements") && n.get("pendingRequirements").asBoolean();
        examiner = n.has("requiresExaminer") && n.get("requiresExaminer").asBoolean();
      }
    } catch (Exception ex) {}
    if (!stp) { allStp = false; }
    if (pending) { anyPending = true; }
    if (examiner) { anyExaminer = true; }
  }
}
if (total == 0) { allStp = false; anyExaminer = true; }
kcontext.setVariable("caseStpEligible", Boolean.valueOf(allStp));
String oc = allStp ? "STP" : (anyExaminer ? "EXAMINER" : (anyPending ? "PENDING" : "EXAMINER"));
kcontext.setVariable("outcome", oc);
System.out.println("[BPM][AGGREGATE] caseStpEligible=" + allStp + " | outcome=" + oc + " | claims=" + total + " (examiner=" + anyExaminer + ", pending=" + anyPending + ")");]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:exclusiveGateway id="_P_OUTCOME" name="Outcome" gatewayDirection="Diverging">
      <bpmn2:extensionElements>
