    <bpmn2:callActivity id="_P_UPDATE_PENDING" drools:independent="true" drools:waitForCompletion="true" name="Update Case AND claim status to Pending Req" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname"><drools:metaValue><![CDATA[Update Case AND claim status to Pending Req]]></drools:metaValue></drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY:UpdatePendingReq] process=pru-claims-examination | caseId=" + kcontext.getVariable("caseId"));
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("cid", kcontext.getVariable("cid"));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.put("status", "PENDING_REQUIREMENTS");
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script>
