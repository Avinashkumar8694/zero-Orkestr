    <bpmn2:scriptTask id="_P_TI_CONSOLIDATE" name="Consolidate TI Flags for the Case" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Consolidate TI Flags for the Case]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_F_TI1</bpmn2:incoming>
      <bpmn2:outgoing>_F_TI2</bpmn2:outgoing>
      <bpmn2:script><![CDATA[// US 11.07 Consolidate TI Flags for the Case. TI is always non-STP (AD-32):
// no STP roll-up, no Outcome gateway; the case always proceeds to the Reviewer.
java.util.List results = (java.util.List) kcontext.getVariable("claimResults");
int total = results != null ? results.size() : 0;
kcontext.setVariable("outcome", "REVIEWER");
System.out.println("[BPM][TI-CONSOLIDATE] process=pru-claims-examination | caseId=" + kcontext.getVariable("caseId") + " | tiClaims=" + total + " | outcome=REVIEWER (TI always non-STP)");]]></bpmn2:script>
    </bpmn2:scriptTask>
