          <drools:metaValue><![CDATA[Outcome]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_F_AGG</bpmn2:incoming>
      <bpmn2:outgoing>_F_STP</bpmn2:outgoing>
      <bpmn2:outgoing>_F_PENDING</bpmn2:outgoing>
      <bpmn2:outgoing>_F_EXAMINER</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
