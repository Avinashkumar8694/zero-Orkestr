      <bpmn2:dataOutputAssociation id="doa_P_RUN_res"><bpmn2:sourceRef>_P_RUN_claimResultsOutputX</bpmn2:sourceRef><bpmn2:targetRef>claimResults</bpmn2:targetRef></bpmn2:dataOutputAssociation>
