    </bpmn2:endEvent>
    <bpmn2:scriptTask id="_BUILD_CTX" name="Build Context" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Build Context]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_F3</bpmn2:incoming>
      <bpmn2:outgoing>_F4</bpmn2:outgoing>
      <bpmn2:script><![CDATA[
String urlVal = (String) kcontext.getVariable("Url");
String payloadVal = (String) kcontext.getVariable("ContentData");
String methodVal = (String) kcontext.getVariable("Method");
String headersVal = (String) kcontext.getVariable("Headers");

if (urlVal == null) urlVal = "";
if (payloadVal == null || payloadVal.isEmpty()) payloadVal = "{}";
if (methodVal == null) methodVal = "POST";
String escapedHeaders = headersVal != null ? headersVal.replace("\"", "\\\"") : "";

String ctx = "{\"url\":\"" + urlVal + "\", \"payload\":" + payloadVal + ", \"method\":\"" + methodVal + "\", \"headers\":\"" + escapedHeaders + "\"}";
kcontext.setVariable("failedContext", ctx);
      ]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:endEvent id="_END_ERROR_TERMINATE" name="Throw Terminate Error">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Throw Terminate Error]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_F_REST_TO_THROW_ERR</bpmn2:incoming>
      <bpmn2:errorEventDefinition id="_7qCpE1jZEfGoNpO8onZRMw" drools:erefname="TERMINATE_CASE" errorRef="TERMINATE_CASE"/>
    </bpmn2:endEvent>
    <bpmn2:scriptTask id="_PRE_EXECUTE" name="Pre-Execute Params Sanity" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Pre-Execute Params Sanity]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_F1</bpmn2:incoming>
      <bpmn2:outgoing>_F_PRE_TO_REST</bpmn2:outgoing>
      <bpmn2:script><![CDATA[
Object handleErr = kcontext.getVariable("HandleResponseErrors");
if (handleErr instanceof Boolean) {
    kcontext.setVariable("HandleResponseErrors", String.valueOf((Boolean) handleErr));
} else if (handleErr != null) {
    kcontext.setVariable("HandleResponseErrors", handleErr.toString());
} else {
    kcontext.setVariable("HandleResponseErrors", "false");
}

Object connTimeout = kcontext.getVariable("ConnectTimeout");
if (connTimeout != null) {
    kcontext.setVariable("ConnectTimeout", connTimeout.toString());
}
Object readTimeout = kcontext.getVariable("ReadTimeout");
if (readTimeout != null) {
    kcontext.setVariable("ReadTimeout", readTimeout.toString());
}
      ]]></bpmn2:script>
    </bpmn2:scriptTask>
