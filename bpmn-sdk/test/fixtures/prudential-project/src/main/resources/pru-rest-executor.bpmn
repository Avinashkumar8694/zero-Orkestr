    <bpmn2:sequenceFlow id="_F_REST_TO_THROW_ERR" name="Terminate" sourceRef="_GATE_CHECK_DECISION" targetRef="_END_ERROR_TERMINATE">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Terminate]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_7qCpEVjZEfGoNpO8onZRMw" language="http://www.java.com/java"><![CDATA[return "TERMINATE".equals(adminDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_F5" sourceRef="_CALL_ERR" targetRef="_GATE_CHECK_DECISION"/>
    <bpmn2:sequenceFlow id="_F_REST_TO_END_ERROR" name="Continue/Skip" sourceRef="_GATE_CHECK_DECISION" targetRef="_END_ERROR">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Continue/Skip]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_7qCpEljZEfGoNpO8onZRMw" language="http://www.java.com/java"><![CDATA[return !"TERMINATE".equals(adminDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:endEvent id="_END_SUCCESS" name="End Success">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[End Success]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
