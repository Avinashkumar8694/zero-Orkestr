      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_KpPV11tXEfGoNpO8onZRMw" language="http://www.java.com/java"><![CDATA[int count = (int) kcontext.getVariable("followupCount");
String _claimType = (String) kcontext.getVariable("claimType");
if ("TI".equals(_claimType)) {
    return count >= 1;
} else {
    return count >= 4;
}]]></bpmn2:conditionExpression>
