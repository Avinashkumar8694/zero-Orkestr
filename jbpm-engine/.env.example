# ==============================================================================
# JBPM Engine — Production & Multi-Replica Environment Configuration
# ==============================================================================

# PILLAR 1: Storage Backend (MANDATORY 'pg' for production & multi-replica)
STORE=pg
PG_URL=postgresql://jbpm:jbpm@localhost:5434/jbpm

# PILLAR 2: Fully Automatic Pure Active-Active Concurrent Timer Coordination
# (Zero manual role configuration required — all replicas auto-coordinate via PostgreSQL SKIP LOCKED)
ROLE=all
TIMER_TICK_INTERVAL_MS=5000
TIMER_BATCH_SIZE=50

# PILLAR 3: Connection Pooler
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECTION_TIMEOUT_MS=5000

# Security & Server
PORT=4000
JWT_SECRET=dev-insecure-secret-change-me-in-production
ADMIN_INITIAL_PASSWORD=admin-change-me-in-production
