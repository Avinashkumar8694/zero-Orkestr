# ==============================================================================
# JBPM Engine Server — Production & Multi-Replica Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# PILLAR 1: STORAGE BACKEND & DATABASE POOLING
# ------------------------------------------------------------------------------
# Storage backend:
#   'file' - Zero-dependency local developer sandbox (saves JSON files in .data/). Single process only.
#   'pg'   - MANDATORY for production and any multi-replica / multi-pod deployment.
#            Provides ACID transactions, row-level locking, and shared state across replicas.
STORE=pg

# PostgreSQL Connection URL:
# Direct PostgreSQL connection or through PgBouncer connection pooler:
#   Direct:    postgresql://jbpm:jbpm@localhost:5434/jbpm
#   PgBouncer: postgresql://jbpm:jbpm@localhost:6432/jbpm
PG_URL=postgresql://jbpm:jbpm@localhost:5434/jbpm

# Database Connection Pool Sizing (per replica):
# Total DB connections = (Number of Replicas) * PG_POOL_MAX.
# Ensure (Total Connections) < PostgreSQL server max_connections.
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# PILLAR 2: AUTO-SCALED PURE ACTIVE-ACTIVE CONCURRENT TIMER COORDINATION
# ------------------------------------------------------------------------------
# ZERO manual configuration required!
# Replicas automatically coordinate using PostgreSQL atomic `FOR UPDATE SKIP LOCKED`.
# When scaled to 1, 2, 5, or 20+ replicas (e.g. via Kubernetes HPA), ALL replicas
# act concurrently as competing consumers: each replica claims a distinct slice
# of due timer jobs and processes them in parallel with zero duplicate firings.
#
# Process Role (Optional override, defaults to 'all'):
#   'all'    - (Default) Fully automatic Active-Active mode (Stateless REST + WS + Concurrent Timer Worker).
#   'api'    - (Optional) Pure stateless REST/WS only (disables background timer loop).
#   'worker' - (Optional) Pure dedicated background scheduler (e.g. standalone background deployment).
ROLE=all

# Timer Scheduler Interval & Batch Size:
# Interval (ms) between scheduler ticks per replica:
TIMER_TICK_INTERVAL_MS=5000

# Maximum due timer jobs claimed per replica per tick batch (default: 50).
# Multiple replicas concurrently claim separate batches (e.g. 4 replicas process 200 jobs in parallel).
TIMER_BATCH_SIZE=50

# ------------------------------------------------------------------------------
# SERVER & SECURITY
# ------------------------------------------------------------------------------
PORT=4000
DATA_DIR=.data
JWT_SECRET=dev-insecure-secret-change-me-in-production
ADMIN_INITIAL_PASSWORD=admin-change-me-in-production
DEFAULT_TENANT=default
WS_PATH=/ws

# ------------------------------------------------------------------------------
# INTEGRATIONS & OUTBOUND SSRF SECURITY
# ------------------------------------------------------------------------------
INTEGRATION_BASE_URL=http://localhost:3000
SCRIPT_TIMEOUT_MS=2000
# Comma-separated list of approved absolute outbound hostnames for HTTP service tasks:
OUTBOUND_ALLOWLIST=api.internal.pru.com,gateway.internal.pru.com
