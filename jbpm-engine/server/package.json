{
  "name": "@fabrixly/jbpm-engine-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BPM engine backend: Express API + token execution engine + stores",
  "main": "dist/index.js",
  "scripts": {
    "build:sidecar": "JAVAC=''; for c in \"$JAVA_HOME/bin/javac\" /opt/homebrew/opt/openjdk@17/bin/javac /opt/homebrew/opt/openjdk@21/bin/javac /usr/local/opt/openjdk@17/bin/javac \"$(which javac 2>/dev/null)\"; do [ -x \"$c\" ] && \"$c\" -version >/dev/null 2>&1 && JAVAC=\"$c\" && break; done; [ -n \"$JAVAC\" ] && [ -d ../java-runtime/src ] && mkdir -p ../java-runtime/out && \"$JAVAC\" -encoding UTF-8 -d ../java-runtime/out $(find ../java-runtime/src -name '*.java') || true",
    "predev": "npm run build:sidecar",
    "pretest": "sh ../scripts/prepare-tests.sh",
    "prebuild": "npm run build:sidecar",
    "prestart": "npm run build:sidecar",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:pg": "node --import tsx --test test/pg/*.test.ts",
    "docker:up": "docker-compose -f ../docker-compose.yml up -d",
    "docker:down": "docker-compose -f ../docker-compose.yml down",
    "test:live": "sh ../scripts/live-cluster.sh"
  },
  "dependencies": {
    "@fabrixly/bpmn-sdk": "file:../../bpmn-sdk",
    "ajv": "^8.20.0",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "isolated-vm": "^6.2.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.5.10",
    "tsup": "^8.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
